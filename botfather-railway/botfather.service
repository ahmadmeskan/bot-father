# botfather.service — اجرای دائمی ربات با systemd
# نصب:  sudo cp botfather.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now botfather
# وضعیت/لاگ:  systemctl status botfather   |   journalctl -u botfather -f
#
# کاربر اجراکننده: botrunner (deploy.sh همین کاربر را می‌سازد؛
# اگر دستی نصب می‌کنید User/Group را به کاربر خودتان تغییر دهید)

[Unit]
Description=Telegram BotFather (mother+child bots)
After=network-online.target
Wants=network-online.target
# حداکثر ۱۰ استارت در هر ۵ دقیقه؛ بیشتر از این یعنی crash-loop
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=botrunner
Group=botrunner
WorkingDirectory=/opt/botfather
ExecStart=/opt/botfather/venv/bin/python main.py
Restart=always
RestartSec=10

# ── ایمنی: حداقل دسترسی لازم ──
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botfather
PrivateTmp=true

# ── لاگ: خروجی به journald می‌رود ──
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botfather

[Install]
WantedBy=multi-user.target
